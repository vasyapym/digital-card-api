{
  "name": "quiet-index",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted keyword and semantic search over an Obsidian vault, plus the read-only GraphQL API of a digital business card",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "check-env": "node dist/config/check-env.js",
    "seed": "node dist/seed/seed.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:setup": "prisma migrate deploy && npm run seed",
    "test": "jest"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.0",
    "@huggingface/transformers": "3.5.1",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "^6.16.0",
    "graphql": "^16.11.0",
    "gray-matter": "4.0.3",
    "markdown-it": "14.1.0",
    "prisma": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testEnvironment": "node"
  }
}
