generator client {
  provider     = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  isPrimary Boolean @default(false)
  name      String
  title     String
  description String
  location  String?
  email     String?

  links       Link[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
}

model Link {
  id        Int     @id @default(autoincrement())
  label     String
  url       String
  sortOrder Int     @default(0)
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  category  String
  sortOrder Int     @default(0)
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
}

model Experience {
  id           Int       @id @default(autoincrement())
  company      String
  position     String
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  description  String?
  achievements String[]
  sortOrder    Int       @default(0)
  profileId    Int
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  url           String
  repositoryUrl String?
  technologies  String[]
  sortOrder     Int      @default(0)
  profileId     Int
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Second brain v1. These four models exist so Prisma's schema does not drift from the
/// database; the app and the indexer touch these tables only via $queryRaw/$executeRaw
/// (tsv is generated, emb is a pgvector column — neither is representable in the client).
model BrainNote {
  id          String   @id
  path        String   @unique
  name        String
  title       String
  keys        String[]
  tags        String[] @default([])
  frontmatter Json     @default("{}")
  body        String
  hash        String
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)
  indexedAt   DateTime @default(now()) @map("indexed_at") @db.Timestamptz(6)

  chunks BrainChunk[]
  links  BrainLink[]

  @@index([keys(ops: ArrayOps)], map: "brain_notes_keys_gin", type: Gin)
  @@map("brain_notes")
}

model BrainChunk {
  id      BigInt                   @id @default(autoincrement())
  noteId  String                   @map("note_id")
  ord     Int
  heading String                   @default("")
  anchor  String                   @default("")
  text    String
  /// GENERATED ALWAYS AS (...) STORED — owned by the migration, never written by Prisma.
  tsv     Unsupported("tsvector")?
  emb     Unsupported("vector(384)")

  note BrainNote @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "brain_chunks_note_id_fkey")

  @@unique([noteId, ord])
  @@map("brain_chunks")
}

model BrainLink {
  srcId  String @map("src_id")
  dstKey String @map("dst_key")

  src BrainNote @relation(fields: [srcId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "brain_links_src_id_fkey")

  @@id([srcId, dstKey])
  @@index([dstKey], map: "brain_links_dst")
  @@map("brain_links")
}

model BrainMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("brain_meta")
}
